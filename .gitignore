# === Secrets (NEVER commit these) ===
serviceAccount.json
*.key
.env
credentials*.json

# === Compiled Python ===
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
MANIFEST

# === Backups (duplicates of augur_strategies) ===
backups/

# === User data / uploads (too large/personal) ===
augur_uploads/
augur_watch/_ingested/
*.csv
*.sqlite
*.db
augur_config.json
optimizer_history.db
trial_cache.db*

# === Claude settings (local only) ===
.claude/settings.local.json

# === Streamlit cache ===
.streamlit/cache/
.streamlit/*.lock

# === IDE / editor ===
.vscode/
.idea/
*.swp
*.swo

# === OS files ===
.DS_Store
Thumbs.db
desktop.ini

# === Logs / temp ===
*.log
tmp/
temp/

# Alpaca API credentials (stock data importer) — never commit
tools/.alpaca_keys.json
.alpaca_keys.json

# tools/feature_board.py trade + Firestore-doc cache (rebuildable; the doc cache also
# holds a copy of run-doc contents that should never end up in git history)
tools/_featboard_cache/

# score-report bar cache: these ARE the record for trades that have aged out of the
# free 30-day intraday window, so they must be versioned (overrides the *.csv rule above)
!tools/data/score_bars/*.csv

# transient artifact from tools/preflight_boot.py (normally self-cleaned;
# a killed/interrupted run can leave it behind, where it blocks wt.py ship)
tools/_boot_probe.html

# generated by tools/allpools_render_test.py
tools/_allpools_probe.html

# paper_render_probe.py debug dump (PAPERPROBE_DUMP=1)
_paperprobe_dump.json
# report_render_probe.py debug dump (REPORTPROBE_DUMP=1)
_reportprobe_dump.json
# import_tz_probe.py scratch page dir (self-cleaned; an interrupted run can leave one behind)
_importtzprobe-*/

# exit_autopsy.py per-leg rich-trade cache (rebuilt from the engine any time)
tools/_exit_cache/

# trade_anatomy per-trade CSVs are regenerable (8 MB); md/json/png are kept
docs/anatomy/*_trades.csv

# FOMC decision-day list used by tools/leg_scan_ideas.py + trade_anatomy calendar features (tiny reference data, overrides *.csv)
!tools/data/fomc_dates.csv
tools/data/score_pending.json
tools/data/score_inbox/
tools/data/paper_review_inbox/
# setup-journal bar windows: the permanent OHLC record behind setups/*.md (same reason as above)
!tools/data/setup_bars/*.csv
# exact NQ/ES contract-switch tables rebuilt from databento_raw (ROLL_AUDIT.md; tiny reference data, overrides *.csv)
!tools/data/contract_switches_*.csv
# named splice-artifact shadow trades ROLL_AUDIT 4.5.4 identifies (roll/roll_guard_marks; tiny reference data)
!tools/data/roll_marked_trades.csv
# this lane's own audited in-bar splice times (ROLL_AUDIT 6.3) until the data lane's
# contract_switches_*.csv distinguishes a real splice from a weekend-gap placeholder
# (roll/roll_guard_marks review finding; tiny reference data)
!tools/data/roll_splices.csv
