# === Secrets (NEVER commit these) ===
serviceAccount.json
*.key
.env
credentials*.json

# === Compiled Python ===
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
MANIFEST

# === Backups (duplicates of augur_strategies) ===
backups/

# === User data / uploads (too large/personal) ===
augur_uploads/
augur_watch/_ingested/
*.csv
*.sqlite
*.db
augur_config.json
optimizer_history.db
trial_cache.db*

# === Claude settings (local only) ===
.claude/settings.local.json

# === Streamlit cache ===
.streamlit/cache/
.streamlit/*.lock

# === IDE / editor ===
.vscode/
.idea/
*.swp
*.swo

# === OS files ===
.DS_Store
Thumbs.db
desktop.ini

# === Logs / temp ===
*.log
tmp/
temp/

# Alpaca API credentials (stock data importer) — never commit
tools/.alpaca_keys.json
.alpaca_keys.json

# score-report bar cache: these ARE the record for trades that have aged out of the
# free 30-day intraday window, so they must be versioned (overrides the *.csv rule above)
!tools/data/score_bars/*.csv

# transient artifact from tools/preflight_boot.py (normally self-cleaned;
# a killed/interrupted run can leave it behind, where it blocks wt.py ship)
tools/_boot_probe.html

# generated by tools/allpools_render_test.py
tools/_allpools_probe.html

# paper_render_probe.py debug dump (PAPERPROBE_DUMP=1)
_paperprobe_dump.json
# report_render_probe.py debug dump (REPORTPROBE_DUMP=1)
_reportprobe_dump.json
