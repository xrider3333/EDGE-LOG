[Unit]
Description=EDGE-LOG QQQ shadow adapter + Webull order mirror (standalone, cloud)
Documentation=https://github.com/xrider3333/EDGE-LOG/blob/main/deploy/cloud/README.md
After=network-online.target edgelog-runner.service
Wants=network-online.target

[Service]
Type=simple
User=__EDGELOG_USER__
WorkingDirectory=__EDGELOG_REPO__
EnvironmentFile=__EDGELOG_HOME__/edgelog.env
# LINUX LAUNCH APPROACH (see api/qqq_exec.py's ensure_standalone() docstring): on
# Windows the runner launches this via a detached .vbs when nothing is serving; on
# Linux there is no equivalent supervisor for a bare subprocess, so this dedicated
# systemd unit IS the standalone process instead. It follows api/qqq_exec.py's LEASE
# PROTOCOL: it takes this machine's serving slot (an OS lock on SERVING.lock.mutex, the
# same lock the runner's fallback thread must take, so the two can never both tick), then
# claims the cross-host lease by compare-and-set. While the OTHER host (the owner's PC)
# holds a fresh lease it logs REFUSING, leaves a SERVING.lock.standby marker that keeps
# the runner's fallback thread off, and exits -- Restart=always below is what re-checks
# every ~15 s. A copy that finds the lease taken while serving logs STANDING DOWN and
# exits the same way. So starting this unit is always safe to try; it just won't trade
# while the PC is still the active host.
#
# START ORDER: start THIS unit, then edgelog-runner.service, so the book runs here and
# not in the runner's fallback thread. Either order is safe -- the slot lock means one
# copy per machine -- but a fallback copy that wins the lock first keeps the book inside
# the runner process until the runner restarts.
Environment=EDGELOG_HOST_ROLE=cloud
ExecStart=__EDGELOG_VENV__/bin/python -u -m api.qqq_exec --serve --uid __EDGELOG_ALLOW_UID__ --cred serviceAccount.json
Restart=always
RestartSec=15
StandardOutput=append:__EDGELOG_HOME__/logs/qqq_exec.log
StandardError=append:__EDGELOG_HOME__/logs/qqq_exec.log
Nice=0
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
