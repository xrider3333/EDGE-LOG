 "armb_reading": [
  "session = one ET calendar day of the master (day_id); bar 0 = the session's first bar in the data (every session in the window starts 09:30, checked in the harness)",
  "prior_close = close of the LAST bar of the PREVIOUS session present in the loaded data (no calendar-gap check); the first session of the loaded window has no prior close -> skipped",
  "gap = open[bar 0] - prior_close; LONG if gap > +gap_min_pts, SHORT if gap < -gap_min_pts (strict inequalities), else no trade",
  "entry fills at bar 0's OPEN; one trade per session; 1 contract",
  "ATR = simple mean of TRUE RANGE over the prior session's last atr_bars bars; TR = max(h-l, |h-prev_c|, |l-prev_c|) with prev_c the previous bar's close when that bar is in the same prior session, else h-l; a prior session with fewer than atr_bars bars -> no ATR -> session skipped (never happens in this window); no Wilder smoothing",
  "stop = entry - stop_frac*ATR (long) / entry + stop_frac*ATR (short), FIXED at entry ('trailing' read as the ATR window, not a trailing stop)",
  "stop live from the entry bar (bar 0) on: on bars after the entry bar, a bar whose OPEN is at/past the stop exits at that open; otherwise a bar whose low (long) / high (short) touches the stop exits AT the stop price",
  "no target, no time stop: else exit at the CLOSE of the session's last bar in the data (half-days / short sessions = their own last bar)",
  "gross pts = side * (exit_px - entry_px); trades recorded at the FILL bars (global indices)"
 ],
