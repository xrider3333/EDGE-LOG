#!/bin/sh
# EDGE-LOG pre-push boot gate.
#
# Runs tools/preflight_boot.py before every `git push` in this repo. That
# script boots index.html in headless Chrome and checks it actually renders
# (plus a static lint for the v53.3 malformed-template-tag bug class).
#
# Exit codes from preflight_boot.py:
#   0 = PASS          -> allow the push
#   1 = FAIL          -> definitely broken -> BLOCK the push
#   2 = INCONCLUSIVE  -> tooling could not run (e.g. chrome missing/timeout)
#                        -> non-blocking, allow the push with a warning
#
# Wired up via: git config core.hooksPath tools/githooks
#
# Emergency override (only if the owner asks for it): git push --no-verify

repo_root="$(git rev-parse --show-toplevel)"

python "$repo_root/tools/preflight_boot.py"
status=$?

if [ "$status" -eq 1 ]; then
  echo ""
  echo "Boot gate FAILED -- refusing to push a broken index.html."
  echo "Fix it, or override with: git push --no-verify"
  echo ""
  exit 1
fi

if [ "$status" -eq 2 ]; then
  echo ""
  echo "Boot gate INCONCLUSIVE -- could not verify index.html boots (tooling issue), allowing push anyway."
  echo ""
fi

# ---------------------------------------------------------------------------
# EXECUTION-FEASIBILITY GATE (added 2026-08-11, after the ORB look-ahead)
#
# The ORB family filled at the range edge intrabar while gating the trade on
# that bar's FINISHED volume. Walk-forward, lockbox and the ES transfer all
# re-ran the same engine, so it passed every statistical check we had. Nothing
# in the repo would have caught it. This is that missing check.
#
# It only audits STRATEGY FILES CHANGED IN THIS PUSH, so the known-dead ORB
# family does not block unrelated work. A hard failure means the file would
# hand back a number nobody could trade.
# ---------------------------------------------------------------------------
if [ -f "$repo_root/tools/exec_feasibility_audit.py" ]; then
  python "$repo_root/tools/exec_feasibility_audit.py" --changed
  efa=$?
  if [ "$efa" -eq 1 ]; then
    echo ""
    echo "Execution-feasibility gate FAILED -- a changed strategy would produce a number you cannot trade."
    echo "Fix it, or override with: git push --no-verify"
    echo ""
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# STRATEGY-CONTRACT GATE (added 2026-08-27)
#
# WHY: CI (.github/workflows/tests.yml) runs the suite on every push to main,
# and a red main emails the owner once PER PUSH. Twice now a broken strategy
# file has sat on main for a day while unrelated pushes piled up notifications:
#   - the quarantined-stub break (fixed 047b427)
#   - ORB_3_4_ER_1_0 forwarding **kw into a base engine that has no **kw, so the
#     engine-supplied `index` blew up with a TypeError (landed 56960d9,
#     2026-08-25; 8 failure emails before anyone looked)
# BOTH were caught by tests/test_strategy_contract.py, BOTH reproduced locally
# in under two seconds, and neither was ever run before pushing. Nothing in the
# repo asked for them. This is that missing check.
#
# Scope + cost: the whole battery is 557 tests across every strategy and takes
# ~5 SECONDS, so it runs on any push that touches Python at all rather than
# trying to guess which strategies a change can reach. Pushes that touch only
# index.html -- the large majority -- are unaffected and pay nothing.
#
# Deliberately NOT the full suite: that is ~4 minutes locally, which is a real
# tax on every Python push across concurrent sessions. The contract battery is
# the part that has actually caught the breaks; CI still runs everything.
# ---------------------------------------------------------------------------
base_ref="$(git merge-base HEAD origin/main 2>/dev/null || echo origin/main)"
if git diff --name-only "$base_ref" -- 2>/dev/null | grep -qE '\.py$'; then
  python -m pytest "$repo_root/tests/test_strategy_contract.py" -q
  contract=$?
  if [ "$contract" -ne 0 ]; then
    echo ""
    echo "Strategy-contract gate FAILED -- this push would turn main red and start"
    echo "a failure email for every push after it. Fix it, or override with:"
    echo "  git push --no-verify"
    echo ""
    exit 1
  fi
fi

exit 0
