#!/bin/sh
# EDGE-LOG pre-push boot gate.
#
# Runs tools/preflight_boot.py before every `git push` in this repo. That
# script boots index.html in headless Chrome and checks it actually renders
# (plus a static lint for the v53.3 malformed-template-tag bug class).
#
# Exit codes from preflight_boot.py:
#   0 = PASS          -> allow the push
#   1 = FAIL          -> definitely broken -> BLOCK the push
#   2 = INCONCLUSIVE  -> tooling could not run (e.g. chrome missing/timeout)
#                        -> non-blocking, allow the push with a warning
#
# Wired up via: git config core.hooksPath tools/githooks
#
# Emergency override (only if the owner asks for it): git push --no-verify

repo_root="$(git rev-parse --show-toplevel)"

# What git is pushing ('<local ref> <local sha> <remote ref> <remote sha>' per line), read FIRST,
# before any gate below could consume stdin. tools/hook_tests.py uses it to check that the commit
# being pushed is the tree its tests run on (2026-10-08).
push_refs=""
if [ ! -t 0 ]; then
  push_refs="$(cat)"
fi

python "$repo_root/tools/preflight_boot.py"
status=$?

if [ "$status" -eq 1 ]; then
  echo ""
  echo "Boot gate FAILED -- refusing to push a broken index.html."
  echo "Fix it, or override with: git push --no-verify"
  echo ""
  exit 1
fi

if [ "$status" -eq 2 ]; then
  echo ""
  echo "Boot gate INCONCLUSIVE -- could not verify index.html boots (tooling issue), allowing push anyway."
  echo ""
fi

# ---------------------------------------------------------------------------
# EXECUTION-FEASIBILITY GATE (added 2026-08-11, after the ORB look-ahead)
#
# The ORB family filled at the range edge intrabar while gating the trade on
# that bar's FINISHED volume. Walk-forward, lockbox and the ES transfer all
# re-ran the same engine, so it passed every statistical check we had. Nothing
# in the repo would have caught it. This is that missing check.
#
# It only audits STRATEGY FILES CHANGED IN THIS PUSH, so the known-dead ORB
# family does not block unrelated work. A hard failure means the file would
# hand back a number nobody could trade.
# ---------------------------------------------------------------------------
if [ -f "$repo_root/tools/exec_feasibility_audit.py" ]; then
  python "$repo_root/tools/exec_feasibility_audit.py" --changed
  efa=$?
  if [ "$efa" -eq 1 ]; then
    echo ""
    echo "Execution-feasibility gate FAILED -- a changed strategy would produce a number you cannot trade."
    echo "Fix it, or override with: git push --no-verify"
    echo ""
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# THE TEST TIERS (strategy-contract gate added 2026-08-27; tiers 2026-08-27 / 10-02; run by
# tools/hook_tests.py since 2026-10-08)
#
# WHY: CI (.github/workflows/tests.yml) runs the suite on every push to main,
# and a red main emails the owner once PER PUSH. Twice now a broken strategy
# file has sat on main for a day while unrelated pushes piled up notifications:
#   - the quarantined-stub break (fixed 047b427)
#   - ORB_3_4_ER_1_0 forwarding **kw into a base engine that has no **kw, so the
#     engine-supplied `index` blew up with a TypeError (landed 56960d9,
#     2026-08-25; 8 failure emails before anyone looked)
# BOTH were caught by tests/test_strategy_contract.py, BOTH reproduced locally
# in under two seconds, and neither was ever run before pushing. Nothing in the
# repo asked for them. This is that missing check.
#
# The tiers - unchanged, now in tools/hook_tests.py `tiers()` so the pre-lock run and this hook
# can never disagree about them:
#
#   contract   any *.py touched                       tests/test_strategy_contract.py
#   engine     augur_engine/ api/ augur_mp_worker.py  everything bar contract + surrogate
#              tests/ touched
#   surrogate  augur_engine/surrogate.py touched      tests/test_surrogate.py (~4 min)
#   tools      tools/<name>.py touched, engine not    tests/test_<name>.py + companions
#              due (65a5352c turned main red through tools/wt.py on the contract tier alone)
#
# WHAT CHANGED 2026-10-08: THE ENGINE TIER NO LONGER RUNS IN FULL UNDER THE PUSH LOCK. It took
# 20-40 minutes per ship with the lock held, so 25 queued ships meant a 7-13 hour queue. `wt.py
# ship` now runs these same tiers BEFORE it takes the lock (`hook_tests.py prelock`), and every
# pytest run that passes on a clean worktree stamps the test files that really ran green on that
# tree. Here, on the final tree, a needed test file is skipped only when such a stamp exists AND
# tools/affected_tests.py - asked about the real `git diff` between that tree and this one,
# computed in here - says the difference cannot reach it. Everything else, and a small always-run
# SMOKE set, runs on this tree. Any doubt (no stamp, dirty worktree, a pushed commit that is not
# the tree on disk, conftest/pytest.ini/requirements changed, a deleted or renamed module, the
# deciding code itself changed, another Python environment, a stamp over 12 h old) runs the tier
# in full with the very command this hook always used. The variable EDGELOG_GATE_PASSED_TREE
# that ship sets on a retry is no longer read: a stamp is a record of a real run, the variable
# was only ever a claim. See tools/hook_tests.py.
#
# A gate people route around is not a gate. The tiering exists so nobody has a
# standing reason to reach for --no-verify.
# ---------------------------------------------------------------------------
if [ ! -f "$repo_root/tools/hook_tests.py" ]; then
  echo ""
  echo "Test gate cannot run -- tools/hook_tests.py is missing from this tree."
  echo "Refusing to push without the test tiers. Restore it, or override with: git push --no-verify"
  echo ""
  exit 1
fi
printf '%s\n' "$push_refs" | python "$repo_root/tools/hook_tests.py" hook --root "$repo_root"
if [ $? -ne 0 ]; then
  echo ""
  echo "Test gate FAILED -- this push would turn main red and start a"
  echo "failure email for every push after it. Fix it, or override with:"
  echo "  git push --no-verify"
  echo ""
  exit 1
fi

exit 0
